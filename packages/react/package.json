{
  "name": "@elfye/react",
  "version": "1.0.0",
  "description": "React hook and input components for Elfye Amharic Phonetic Keyboard",
  "keywords": [
    "elfye",
    "react",
    "amharic",
    "ethiopic",
    "geez",
    "keyboard",
    "transliteration",
    "ime",
    "hook"
  ],
  "author": "Eyob Begashaw",
  "license": "MIT",
  "homepage": "https://github.com/eyobbegashaw/elfye-amharic-keybord#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyobbegashaw/elfye-amharic-keybord.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --test-timeout 20000",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@elfye/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
